# PayPal sandbox app Client ID (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
# PayPal sandbox app Secret (same page; never share it)
PAYPAL_CLIENT_SECRET=
# Gemini API key from aistudio.google.com (used for chat reading, scope checks and the agent)
GOOGLE_GENERATIVE_AI_API_KEY=
# Fake test buyer email (developer.paypal.com > Testing Tools > Sandbox Accounts, type Personal); shown on the pay page
PAYPAL_SANDBOX_BUYER_EMAIL=
# Fake test buyer password for the account above (sandbox only)
PAYPAL_SANDBOX_BUYER_PASSWORD=
# Port the app listens on (default 3000)
PORT=3000
# Currency PayPal charges in (default USD)
API_CURRENCY=USD
# Optional: where the data file lives (default db.json in the project folder)
DB_PATH=
# Optional: where uploaded deliverables are stored (default uploads/ in the project folder)
UPLOAD_DIR=
# Optional: folder holding the demo chat and cached extraction (default fixtures/)
FIXTURES_DIR=
